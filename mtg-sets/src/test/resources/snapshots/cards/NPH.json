// Beast Within
{
    "name": "Beast Within",
    "manaCost": "{2}{G}",
    "typeLine": "Instant",
    "oracleText": "Destroy target permanent. Its controller creates a 3/3 green Beast creature token.",
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "MoveToZone",
                    "target": {
                        "type": "BoundVariable",
                        "name": "target permanent"
                    },
                    "destination": "Graveyard",
                    "byDestruction": true
                },
                {
                    "type": "CreateToken",
                    "power": 3,
                    "toughness": 3,
                    "colors": [
                        "GREEN"
                    ],
                    "creatureTypes": [
                        "Beast"
                    ],
                    "controller": "TargetController"
                }
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "filter": {
                    "baseFilter": "permanent"
                },
                "id": "target permanent"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "103",
        "rarity": "UNCOMMON",
        "artist": "Dave Allsop",
        "imageUri": "https://cards.scryfall.io/normal/front/c/e/ce5b6d19-22e3-4f57-8f4d-a17e982286c7.jpg?1783941304",
        "rulings": [
            {
                "date": "2021-03-19",
                "text": "If the target permanent is an illegal target by the time Beast Within tries to resolve, the spell won't resolve. No player creates a Beast token. If the target is legal but not destroyed (most likely because it has indestructible), its controller does create a Beast token."
            }
        ]
    },
    "colorIdentityOverride": [
        "GREEN"
    ]
}

