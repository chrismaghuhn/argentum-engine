// Sevinne's Reclamation
{
    "name": "Sevinne's Reclamation",
    "manaCost": "{2}{W}",
    "typeLine": "Sorcery",
    "oracleText": "Return target permanent card with mana value 3 or less from your graveyard to the battlefield. If this spell was cast from a graveyard, you may copy this spell and may choose a new target for the copy.\nFlashback {4}{W} (You may cast this card from your graveyard for its flashback cost. Then exile it.)",
    "keywords": [
        "FLASHBACK"
    ],
    "keywordAbilities": [
        {
            "type": "Flashback",
            "cost": "{4}{W}"
        }
    ],
    "script": {
        "spellEffect": {
            "type": "Composite",
            "effects": [
                {
                    "type": "MoveToZone",
                    "target": {
                        "type": "BoundVariable",
                        "name": "t0"
                    },
                    "destination": "Battlefield",
                    "fromZone": "Graveyard"
                },
                {
                    "type": "Gated",
                    "gate": {
                        "type": "Gate.WhenCondition",
                        "condition": {
                            "type": "WasCastFromZone",
                            "zone": "Graveyard"
                        }
                    },
                    "then": {
                        "type": "Gated",
                        "gate": "Gate.MayDecide",
                        "then": {
                            "type": "CopyTargetSpell",
                            "target": "Self"
                        },
                        "descriptionOverride": "You may copy this spell and choose new targets for the copy"
                    }
                }
            ]
        },
        "targetRequirements": [
            {
                "type": "TargetObject",
                "filter": {
                    "baseFilter": "permanent mv<=3 own:you",
                    "zone": "Graveyard"
                },
                "id": "t0"
            }
        ]
    },
    "metadata": {
        "collectorNumber": "5",
        "rarity": "RARE",
        "artist": "Zoltan Boros",
        "imageUri": "https://cards.scryfall.io/normal/front/7/e/7e68f4df-88ce-4e09-a03c-7edf40bff167.jpg?1783932814",
        "rulings": [
            {
                "date": "2019-08-23",
                "text": "The copy that Sevinne's Reclamation creates is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger. The copy wasn't cast from a graveyard, so it won't make another copy of itself."
            },
            {
                "date": "2019-08-23",
                "text": "If you cast Sevinne's Reclamation from your graveyard, any abilities that trigger as the permanent card returns to the battlefield will resolve before the copy of Sevinne's Reclamation resolves but after new targets for the copy have been chosen."
            },
            {
                "date": "2019-08-23",
                "text": "If the target card is an illegal target by the time Sevinne's Reclamation tries to resolve, the spell doesn't resolve. You won't copy it if you cast it from a graveyard."
            },
            {
                "date": "2024-06-07",
                "text": "A permanent card is an artifact, battle, creature, enchantment, land, or planeswalker card."
            }
        ]
    },
    "colorIdentityOverride": [
        "WHITE"
    ]
}
